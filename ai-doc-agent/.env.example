NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Generate with: openssl rand -base64 32
# Keep this server-only and store it in your deployment secret manager.
GITHUB_TOKEN_ENCRYPTION_KEY_V1=

# Generate a separate key with: openssl rand -base64 32
LLM_CONNECTOR_ENCRYPTION_KEY_V1=

# Use environment-specific Azure Storage credentials and a pre-created container.
# Keep the access key server-only and store it in your deployment secret manager.
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_ACCESS_KEY=
AZURE_STORAGE_CONTAINER_NAME=pipeline-uploads
